# Copy this file to `.env` (never committed) and fill in your keys.
# Baseten — key valid ONLY for the hackathon model below.
BASETEN_API_KEY=
# Meta Model API — Muse Spark / Wonder / SAM 3.1 / Muse Image...
META_MODEL_API_KEY=
# Persistent per-scene spending limit (USD, reservations include in-flight calls).
TWINFORGE_SCENE_BUDGET_USD=0.50
# Optional smaller ceiling for the live SAM endpoint only, including its existing
# vision spending. Blank uses the global scene ceiling; never raises that ceiling.
TWINFORGE_LIVE_SAM_BUDGET_USD=
# Optional Muse Glimmer: local endpoint, or Together hosted API. Never substituted silently.
GLIMMER_BASE_URL=
GLIMMER_MODEL=
GLIMMER_API_KEY=
# Together defaults to meta-models/Muse-Glimmer-30B and published token prices.
TOGETHER_API_KEY=
# Required for a different hosted provider; local endpoints incur no API dollar charge.
GLIMMER_INPUT_USD_PER_MILLION=
GLIMMER_OUTPUT_USD_PER_MILLION=
